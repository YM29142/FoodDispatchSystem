@model FoodDispatchSystem.Web.Models.Category

@{
    ViewData["Title"] = "Editar categoría";
}

<div class="mb-4">
    <h1 class="mb-1">
        Editar categoría
    </h1>

    <p class="text-muted mb-0">
        Actualiza la información de la categoría seleccionada.
    </p>
</div>
<div class="row">
    <div class="col-lg-7 col-md-9 product-form-card">
        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nombre</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description"
                       class="form-label">
                    Descripción
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

           <div class="form-check form-switch product-active-switch mb-4">

    <input asp-for="IsActive"
           class="form-check-input" />

    <label asp-for="IsActive"
           class="form-check-label">
        Categoría activa
    </label>

    <div class="form-text">
        Las categorías activas estarán disponibles para organizar productos.
    </div>

</div>

            <button type="submit"
                   class="btn order-create-btn">
                Guardar cambios
            </button>

            <a asp-action="Index"
               class="btn order-cancel-btn">
                Cancelar
            </a>

        </form>

    </div>
</div>

@model IEnumerable<FoodDispatchSystem.Web.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Personal";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                Personal
            </h1>
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">

                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>

                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">

                    @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>
                </div>
            }

            <p class="text-muted mb-0">
                Administra los usuarios que tienen acceso al sistema.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Nuevo empleado
        </a>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">
                                Correo electrónico
                            </th>

                            <th>
                                Rol
                            </th>

                            <th>
                                Estado
                            </th>

                            <th class="text-end pe-4">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-5">

                                    No hay usuarios registrados.

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var user in Model)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <div class="fw-semibold">
                                            @user.Email
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @user.Role
                                        </span>
                                    </td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">

                                        <td class="text-end pe-4">

                                            @if (user.Role == "Administrador")
                                            {
                                                <span class="text-muted small">
                                                    Cuenta administrativa
                                                </span>
                                            }
                                            else
                                            {
                                                <a asp-action="EditRole"
                                                   asp-route-id="@user.Id"
                                                   class="btn btn-sm btn-outline-primary me-1">
                                                    Cambiar rol
                                                </a>

                                                @if (user.IsActive)
                                                {
                                                    <form asp-action="Deactivate"
                                                          asp-route-id="@user.Id"
                                                          method="post"
                                                          class="d-inline">

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                onclick="return confirm('¿Está seguro de desactivar este empleado?');">
                                                            Desactivar
                                                        </button>

                                                    </form>
                                                }
                                                else
                                                {
                                                    <form asp-action="Activate"
                                                          asp-route-id="@user.Id"
                                                          method="post"
                                                          class="d-inline">

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success">
                                                            Activar
                                                        </button>

                                                    </form>
                                                }
                                            }

                                        </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>
            </div>

        </div>

    </div>

</div>
@model FoodDispatchSystem.Web.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

           <div class="card business-settings-card">

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-2">
                        Restablecer contraseña
                    </h3>

                    <p class="text-muted mb-4">
                        Ingresa y confirma tu nueva contraseña.
                    </p>

                    <form asp-action="ResetPassword"
                          method="post">

                        <input asp-for="Email"
                               type="hidden" />

                        <input asp-for="Token"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Password"
                                  class="form-label fw-semibold">
                                Nueva contraseña
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="ConfirmPassword"
                                  class="form-label fw-semibold">
                                Confirmar contraseña
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <button type="submit"
        class="btn order-create-btn w-100">
    Cambiar contraseña
</button>

                    </form>


                    <div class="text-center mt-3">

                      <div class="text-center mt-3">

    <a asp-controller="Account"
       asp-action="Login"
       class="login-forgot-link">
        ← Volver al inicio de sesión
    </a>

</div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
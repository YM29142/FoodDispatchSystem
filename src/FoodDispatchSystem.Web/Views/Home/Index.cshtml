@inject FoodDispatchSystem.Web.Services.BusinessService BusinessService

@{
    @inject FoodDispatchSystem.Web.Services.BusinessTimeService BusinessTimeService
    var business = await BusinessService.GetBusinessAsync();
    var businessName = business?.Name ?? "FoodDispatch";
}
@using FoodDispatchSystem.Web.Models
@model FoodDispatchSystem.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1>Dashboard</h1>
    <p class="text-muted">
        Resumen general de @businessName.
    </p>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-today="true"
           class="text-decoration-none text-dark">
            
           <div class="card shadow-sm h-100 border-secondary dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Pedidos de hoy
                    </h6>

                    <h2 class="mb-0">
                        @Model.OrdersToday
                    </h2>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-status="@OrderStatus.Pending"
           class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100 border-warning dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Pendientes
                    </h6>

                    <h2 class="mb-0">
                        @Model.PendingOrders
                    </h2>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-status="@OrderStatus.Preparing"
           class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100 border-primary dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Preparando
                    </h6>

                    <h2 class="mb-0">
                        @Model.PreparingOrders
                    </h2>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-status="@OrderStatus.Ready"
           class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100 border-info dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Listos para entregar
                    </h6>

                    <h2 class="mb-0">
                        @Model.ReadyOrders
                    </h2>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-status="@OrderStatus.Delivered"
           asp-route-today="true"
           class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100 border-success dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Entregados hoy
                    </h6>

                    <h2 class="mb-0">
                        @Model.DeliveredToday
                    </h2>
                </div>
            </div>

        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-status="@OrderStatus.Delivered"
           asp-route-today="true"
           class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100 border-success dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total entregado hoy
                    </h6>

                    <h2 class="mb-0">
                        @Model.DeliveredTotalToday.ToString("C")
                    </h2>
                </div>
            </div>

        </a>
    </div>
</div>

<hr />

<h4 class="mb-3">
    Accesos rápidos
</h4>

<div class="d-flex flex-wrap gap-2">

    @if (User.IsInRole("Administrador") ||
         User.IsInRole("Cajero"))
    {
        <a asp-controller="Orders"
           asp-action="Create"
           class="btn quick-action-btn quick-action-primary">
            + Nuevo pedido
        </a>
    }

    <a asp-controller="Orders"
       asp-action="Index"
       class="btn quick-action-btn">
        Pedidos
    </a>

    @if (User.IsInRole("Administrador"))
    {
        <a asp-controller="Products"
           asp-action="Index"
           class="btn quick-action-btn">
            Productos
        </a>

        <a asp-controller="Categories"
           asp-action="Index"
           class="btn quick-action-btn">
            Categorías
        </a>
    }

</div>
<hr class="mt-4" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
        Últimos 5 pedidos
    </h4>

  <a asp-controller="Orders"
   asp-action="Index"
   class="btn btn-sm view-all-btn">
    Ver todos
</a>
</div>
@if (Model.RecentOrders.Any())
{
    <div class="recent-orders-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 dashboard-orders-table">

                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Fecha y hora</th>
                        <th>Productos</th>
                        <th>Estado</th>
                        <th>Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td>
                                <strong>
                                    @order.OrderNumber
                                </strong>
                            </td>

                            <td>
                               @(BusinessTimeService.ToLocalTime(order.CreatedAt)
    .ToString("dd/MM/yyyy hh:mm tt"))
                            </td>

                            <td>
                                @order.OrderDetails.Sum(d => d.Quantity)
                            </td>

                            <td>
                                @switch (order.Status)
                                {
                                    case OrderStatus.Pending:
                                        <span class="badge bg-warning text-dark">
                                            Pendiente
                                        </span>
                                        break;

                                    case OrderStatus.Preparing:
                                        <span class="badge bg-primary">
                                            Preparando
                                        </span>
                                        break;

                                    case OrderStatus.Ready:
                                        <span class="badge bg-info text-dark">
                                            Listo
                                        </span>
                                        break;

                                    case OrderStatus.Delivered:
                                        <span class="badge bg-success">
                                            Entregado
                                        </span>
                                        break;

                                    case OrderStatus.Cancelled:
                                        <span class="badge bg-danger">
                                            Cancelado
                                        </span>
                                        break;
                                }
                            </td>

                            <td>
                                @order.Total.ToString("C")
                            </td>

                            <td>
                               <a asp-controller="Orders"
   asp-action="Details"
   asp-route-id="@order.Id"
   class="btn btn-sm order-action-btn order-action-view">
    Ver detalle
</a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary">
        Todavía no hay pedidos registrados.
    </div>
}
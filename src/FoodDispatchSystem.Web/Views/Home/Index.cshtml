@using FoodDispatchSystem.Web.Models
@model FoodDispatchSystem.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1>Dashboard</h1>
    <p class="text-muted">
        Resumen general de la operación del restaurante.
    </p>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-today="true"
           class="text-decoration-none text-dark">
            
           <div class="card shadow-sm h-100 border-secondary dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Pedidos de hoy
                    </h6>

                    <h2 class="mb-0">
                        @Model.OrdersToday
                    </h2>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-status="@OrderStatus.Pending"
           class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100 border-warning dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Pendientes
                    </h6>

                    <h2 class="mb-0">
                        @Model.PendingOrders
                    </h2>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-status="@OrderStatus.Preparing"
           class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100 border-primary dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Preparando
                    </h6>

                    <h2 class="mb-0">
                        @Model.PreparingOrders
                    </h2>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-status="@OrderStatus.Ready"
           class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100 border-info dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Listos para entregar
                    </h6>

                    <h2 class="mb-0">
                        @Model.ReadyOrders
                    </h2>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-status="@OrderStatus.Delivered"
           asp-route-today="true"
           class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100 border-success dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Entregados hoy
                    </h6>

                    <h2 class="mb-0">
                        @Model.DeliveredToday
                    </h2>
                </div>
            </div>

        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Orders"
           asp-action="Index"
           asp-route-status="@OrderStatus.Delivered"
           asp-route-today="true"
           class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100 border-success dashboard-card">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total entregado hoy
                    </h6>

                    <h2 class="mb-0">
                        @Model.DeliveredTotalToday.ToString("C")
                    </h2>
                </div>
            </div>

        </a>
    </div>
</div>

<hr />

<h4 class="mb-3">
    Accesos rápidos
</h4>

<div class="d-flex flex-wrap gap-2">

    <a asp-controller="Orders"
       asp-action="Create"
       class="btn btn-primary">
        Nuevo pedido
    </a>

    <a asp-controller="Orders"
       asp-action="Index"
       class="btn btn-info">
        Pedidos
    </a>

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-warning">
        Productos
    </a>

    <a asp-controller="Categories"
       asp-action="Index"
       class="btn btn-secondary">
        Categorías
    </a>

</div>
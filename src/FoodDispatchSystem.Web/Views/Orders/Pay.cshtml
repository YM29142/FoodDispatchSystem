@model FoodDispatchSystem.Web.ViewModels.OrderPaymentViewModel

@{
    ViewData["Title"] = "Cobrar pedido";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">Cobrar pedido</h2>
                    <p class="text-muted mb-0">
                        @Model.OrderNumber
                    </p>
                </div>

                <a asp-action="Details"
                   asp-route-id="@Model.OrderId"
                   class="btn btn-outline-secondary">
                    Volver
                </a>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">

                    <div class="row text-center">

                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="text-muted small">
                                Total del pedido
                            </div>

                            <div class="fs-3 fw-bold">
                                $@Model.OrderTotal.ToString("N2")
                            </div>
                        </div>

                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="text-muted small">
                                Pagado
                            </div>

                            <div class="fs-3 fw-bold text-success">
                                $@Model.PaidAmount.ToString("N2")
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">
                                Saldo pendiente
                            </div>

                            <div class="fs-3 fw-bold text-danger">
                                $@Model.RemainingAmount.ToString("N2")
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h5 class="mb-4">Registrar pago</h5>

                    <form asp-action="Pay" method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="OrderId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Method"
                                   class="form-label">
                                Método de pago
                            </label>

                            <select asp-for="Method"
                                    asp-items="Html.GetEnumSelectList<FoodDispatchSystem.Web.Models.PaymentMethod>()"
                                    class="form-select">
                                <option value="">
                                    Seleccione...
                                </option>
                            </select>

                            <span asp-validation-for="Method"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Amount"
                                   class="form-label">
                                Monto a pagar
                            </label>

                            <div class="input-group input-group-lg">
                                <span class="input-group-text">$</span>

                                <input asp-for="Amount"
                                       class="form-control"
                                       step="0.01"
                                       min="0.01" />
                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-success btn-lg w-100">
                            Registrar pago
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
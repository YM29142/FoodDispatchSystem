@model IEnumerable<FoodDispatchSystem.Web.Models.Order>
@using FoodDispatchSystem.Web.Models

@{
    ViewData["Title"] = "Pedidos";
}

<h1>Pedidos</h1>
@if (ViewBag.SelectedStatus != null || ViewBag.TodayFilter == true)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">

        <div>
            <strong>Filtro activo:</strong>

            @if (ViewBag.TodayFilter == true &&
                 ViewBag.SelectedStatus == OrderStatus.Delivered)
            {
                <span>Entregados hoy</span>
            }
            else if (ViewBag.TodayFilter == true)
            {
                <span>Pedidos de hoy</span>
            }
            else if (ViewBag.SelectedStatus == OrderStatus.Pending)
            {
                <span>Pendientes</span>
            }
            else if (ViewBag.SelectedStatus == OrderStatus.Preparing)
            {
                <span>Preparando</span>
            }
            else if (ViewBag.SelectedStatus == OrderStatus.Ready)
            {
                <span>Listos para entregar</span>
            }
            else if (ViewBag.SelectedStatus == OrderStatus.Delivered)
            {
                <span>Entregados</span>
            }
            else if (ViewBag.SelectedStatus == OrderStatus.Cancelled)
            {
                <span>Cancelados</span>
            }
        </div>

        <a asp-action="Index"
           class="btn btn-sm btn-outline-primary">
            Mostrar todos
        </a>

    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    @if (User.IsInRole("Administrador") ||
      User.IsInRole("Cajero"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Nuevo pedido
        </a>
    }
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Pedido</th>
            <th>Fecha y hora</th>
            <th>Productos</th>
            <th>Estado</th>
            <th>Total</th>
            <th>Acciones</th>
        </tr>
    </thead>
  

    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>
                    <strong>@order.OrderNumber</strong>
                </td>

                <td>
                    @order.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")
                </td>

                <td>
                    @order.OrderDetails.Sum(d => d.Quantity)
                </td>

                <td>
                    @switch (order.Status)
                    {
                        case OrderStatus.Pending:
                            <span class="badge bg-warning text-dark">
                                Pendiente
                            </span>
                            break;

                        case OrderStatus.Preparing:
                            <span class="badge bg-primary">
                                Preparando
                            </span>
                            break;

                        case OrderStatus.Ready:
                            <span class="badge bg-info text-dark">
                                Listo
                            </span>
                            break;

                        case OrderStatus.Delivered:
                            <span class="badge bg-success">
                                Entregado
                            </span>
                            break;

                        case OrderStatus.Cancelled:
                            <span class="badge bg-danger">
                                Cancelado
                            </span>
                            break;
                    }
                </td>

        <td>
    @order.Total.ToString("C")
</td>

<td>
    <a asp-action="Details"
       asp-route-id="@order.Id"
       class="btn btn-sm btn-info">
        Ver detalle
    </a>

    @* PREPARAR: Administrador o Cocina *@
    @if (order.Status == OrderStatus.Pending &&
         (User.IsInRole("Administrador") ||
          User.IsInRole("Cocina")))
    {
        <form asp-action="UpdateStatus"
              asp-route-id="@order.Id"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="status"
                   value="@((int)OrderStatus.Preparing)" />

            <button type="submit"
                    class="btn btn-sm btn-primary">
                Preparar
            </button>
        </form>
    }

    @* CANCELAR: Administrador o Cajero *@
    @if (order.Status == OrderStatus.Pending &&
         (User.IsInRole("Administrador") ||
          User.IsInRole("Cajero")))
    {
        <form asp-action="UpdateStatus"
              asp-route-id="@order.Id"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="status"
                   value="@((int)OrderStatus.Cancelled)" />

            <button type="submit"
                    class="btn btn-sm btn-danger"
                    onclick="return confirm('¿Está seguro de cancelar este pedido?');">
                Cancelar
            </button>
        </form>
    }

    @* MARCAR LISTO: Administrador o Cocina *@
    @if (order.Status == OrderStatus.Preparing &&
         (User.IsInRole("Administrador") ||
          User.IsInRole("Cocina")))
    {
        <form asp-action="UpdateStatus"
              asp-route-id="@order.Id"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="status"
                   value="@((int)OrderStatus.Ready)" />

            <button type="submit"
                    class="btn btn-sm btn-success">
                Marcar listo
            </button>
        </form>
    }

    @* ENTREGAR: Administrador o Despacho *@
    @if (order.Status == OrderStatus.Ready &&
         (User.IsInRole("Administrador") ||
          User.IsInRole("Despacho")))
    {
        <form asp-action="UpdateStatus"
              asp-route-id="@order.Id"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="status"
                   value="@((int)OrderStatus.Delivered)" />

            <button type="submit"
                    class="btn btn-sm btn-success">
                Entregar
            </button>
        </form>
    }
</td>
                
                
            </tr>
        }
    </tbody>
</table>
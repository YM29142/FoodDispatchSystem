@model IEnumerable<FoodDispatchSystem.Web.Models.Order>
@using FoodDispatchSystem.Web.Models

@{
    ViewData["Title"] = "Pedidos";
}

<h1>Pedidos</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Nuevo pedido
    </a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Pedido</th>
            <th>Fecha y hora</th>
            <th>Productos</th>
            <th>Estado</th>
            <th>Total</th>
            <th>Acciones</th>
        </tr>
    </thead>
  

    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>
                    <strong>@order.OrderNumber</strong>
                </td>

                <td>
                    @order.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")
                </td>

                <td>
                    @order.OrderDetails.Sum(d => d.Quantity)
                </td>

                <td>
                    @switch (order.Status)
                    {
                        case OrderStatus.Pending:
                            <span class="badge bg-warning text-dark">
                                Pendiente
                            </span>
                            break;

                        case OrderStatus.Preparing:
                            <span class="badge bg-primary">
                                Preparando
                            </span>
                            break;

                        case OrderStatus.Ready:
                            <span class="badge bg-info text-dark">
                                Listo
                            </span>
                            break;

                        case OrderStatus.Delivered:
                            <span class="badge bg-success">
                                Entregado
                            </span>
                            break;

                        case OrderStatus.Cancelled:
                            <span class="badge bg-danger">
                                Cancelado
                            </span>
                            break;
                    }
                </td>

                <td>
                    @order.Total.ToString("C")
                   <td>
    <a asp-action="Details"
       asp-route-id="@order.Id"
       class="btn btn-sm btn-info">
        Ver detalle
    </a>

    @if (order.Status == OrderStatus.Pending)
    {
        <form asp-action="UpdateStatus"
              asp-route-id="@order.Id"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="status"
                   value="@((int)OrderStatus.Preparing)" />

            <button type="submit"
                    class="btn btn-sm btn-primary">
                Preparar
            </button>
        </form>

        <form asp-action="UpdateStatus"
              asp-route-id="@order.Id"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="status"
                   value="@((int)OrderStatus.Cancelled)" />

            <button type="submit"
                    class="btn btn-sm btn-danger"
                    onclick="return confirm('¿Está seguro de cancelar este pedido?');">
                Cancelar
            </button>
        </form>
    }
    else if (order.Status == OrderStatus.Preparing)
    {
        <form asp-action="UpdateStatus"
              asp-route-id="@order.Id"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="status"
                   value="@((int)OrderStatus.Ready)" />

            <button type="submit"
                    class="btn btn-sm btn-success">
                Marcar listo
            </button>
        </form>

        <form asp-action="UpdateStatus"
              asp-route-id="@order.Id"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="status"
                   value="@((int)OrderStatus.Cancelled)" />

            <button type="submit"
                    class="btn btn-sm btn-danger"
                    onclick="return confirm('¿Está seguro de cancelar este pedido?');">
                Cancelar
            </button>
        </form>
    }
    else if (order.Status == OrderStatus.Ready)
    {
        <form asp-action="UpdateStatus"
              asp-route-id="@order.Id"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="status"
                   value="@((int)OrderStatus.Delivered)" />

            <button type="submit"
                    class="btn btn-sm btn-success">
                Entregar
            </button>
        </form>
    }
</td>
                
                
            </tr>
        }
    </tbody>
</table>
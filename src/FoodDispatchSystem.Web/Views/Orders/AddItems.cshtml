@model FoodDispatchSystem.Web.ViewModels.OrderAddItemsViewModel

@{
    ViewData["Title"] = "Agregar productos";

    var products =
        ViewBag.Products as List<FoodDispatchSystem.Web.Models.Product>
        ?? new List<FoodDispatchSystem.Web.Models.Product>();
}

<div class="page-header mb-4">
    <h1>Agregar productos</h1>

    <p class="text-muted mb-0">
        Agrega más productos al pedido existente.
    </p>
</div>

<div class="orders-table-card p-4">

    <div class="mb-4">
        <h4 class="mb-2">
            @Model.OrderNumber
        </h4>

        @if (Model.TableNumber.HasValue)
        {
            <span class="text-muted">
                Mesa @Model.TableNumber.Value
            </span>
        }
    </div>

    <form asp-action="AddItems"
          method="post">

        <input asp-for="OrderId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div id="items-container">

            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <div class="row mb-3 order-item">

                    <div class="col-md-6">
                        <label class="form-label">
                            Producto
                        </label>

                        <select asp-for="Items[i].ProductId"
                                class="form-select product-select">

                            <option value="">
                                Seleccione un producto
                            </option>

                            @foreach (var product in products)
                            {
                                <option value="@product.Id">
                                    @product.Name - @product.Price.ToString("C")
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Items[i].ProductId"
                              class="text-danger product-validation">
                        </span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Cantidad
                        </label>

                        <input asp-for="Items[i].Quantity"
                               type="number"
                               min="1"
                               max="100"
                               class="form-control quantity-input" />

                        <span asp-validation-for="Items[i].Quantity"
                              class="text-danger quantity-validation">
                        </span>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <button type="button"
                                class="btn btn-outline-danger remove-item d-none">
                            Quitar
                        </button>
                    </div>

                </div>
            }

        </div>

        <div class="d-flex gap-2 flex-wrap">

            <button type="button"
                    id="add-item"
                    class="btn quick-action-btn">
                + Agregar producto
            </button>

            <button type="submit"
                    class="btn btn-primary">
                Agregar al pedido
            </button>

            <a asp-action="Details"
               asp-route-id="@Model.OrderId"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const container =
            document.getElementById("items-container");

        function reindexItems() {

            const items =
                container.querySelectorAll(".order-item");

            items.forEach((item, index) => {

                const select =
                    item.querySelector(".product-select");

                const quantity =
                    item.querySelector(".quantity-input");

                const productValidation =
                    item.querySelector(".product-validation");

                const quantityValidation =
                    item.querySelector(".quantity-validation");

                const removeButton =
                    item.querySelector(".remove-item");

                select.name =
                    `Items[${index}].ProductId`;

                select.id =
                    `Items_${index}__ProductId`;

                quantity.name =
                    `Items[${index}].Quantity`;

                quantity.id =
                    `Items_${index}__Quantity`;

                if (productValidation) {
                    productValidation.setAttribute(
                        "data-valmsg-for",
                        `Items[${index}].ProductId`
                    );
                }

                if (quantityValidation) {
                    quantityValidation.setAttribute(
                        "data-valmsg-for",
                        `Items[${index}].Quantity`
                    );
                }

                if (items.length === 1) {
                    removeButton.classList.add("d-none");
                }
                else {
                    removeButton.classList.remove("d-none");
                }
            });
        }

        document.getElementById("add-item")
            .addEventListener("click", function () {

                const items =
                    container.querySelectorAll(".order-item");

                const lastItem =
                    items[items.length - 1];

                const lastSelect =
                    lastItem.querySelector(".product-select");

                const lastQuantity =
                    lastItem.querySelector(".quantity-input");

                if (lastSelect.value === "") {
                    alert("Primero seleccione un producto.");
                    lastSelect.focus();
                    return;
                }

                const quantityValue =
                    parseInt(lastQuantity.value);

                if (
                    Number.isNaN(quantityValue) ||
                    quantityValue < 1 ||
                    quantityValue > 100
                ) {
                    alert(
                        "La cantidad debe estar entre 1 y 100."
                    );

                    lastQuantity.focus();
                    return;
                }

                const newItem =
                    items[0].cloneNode(true);

                const select =
                    newItem.querySelector(".product-select");

                const quantity =
                    newItem.querySelector(".quantity-input");

                select.value = "";
                quantity.value = 1;

                newItem
                    .querySelectorAll(".text-danger")
                    .forEach(span => {
                        span.innerHTML = "";
                    });

                container.appendChild(newItem);

                reindexItems();
            });

        container.addEventListener(
            "click",
            function (event) {

                const removeButton =
                    event.target.closest(".remove-item");

                if (!removeButton) {
                    return;
                }

                const items =
                    container.querySelectorAll(".order-item");

                if (items.length === 1) {
                    return;
                }

                removeButton
                    .closest(".order-item")
                    .remove();

                reindexItems();
            }
        );

        reindexItems();
    </script>
}
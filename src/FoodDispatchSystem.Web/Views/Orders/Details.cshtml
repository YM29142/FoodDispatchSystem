@model FoodDispatchSystem.Web.Models.Order
@{
    @inject FoodDispatchSystem.Web.Services.BusinessTimeService BusinessTimeService
    string GetStatusName(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "Pendiente",
            OrderStatus.Preparing => "Preparando",
            OrderStatus.Ready => "Listo",
            OrderStatus.Delivered => "Entregado",
            OrderStatus.Cancelled => "Cancelado",
            _ => status.ToString()
        };
    }

    string GetStatusBadgeClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "bg-warning text-dark",
            OrderStatus.Preparing => "bg-primary",
            OrderStatus.Ready => "bg-info text-dark",
            OrderStatus.Delivered => "bg-success",
            OrderStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
@using FoodDispatchSystem.Web.Models

@{
    ViewData["Title"] = "Detalle del pedido";
}

<div class="mb-4">
    <h1 class="mb-1">
        Detalle del pedido
    </h1>

    <p class="text-muted mb-0">
        Información general y productos registrados en el pedido.
    </p>
</div>

<div class="order-summary-card mb-4">

    <h4 class="mb-3">
        @Model.OrderNumber
    </h4>

    <div class="order-summary-grid">

        <div>
            <span class="order-summary-label">
                Fecha
            </span>

            <div class="order-summary-value">
             @(BusinessTimeService.ToLocalTime(Model.CreatedAt)
    .ToString("dd/MM/yyyy hh:mm tt"))
            </div>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <div>
                <span class="order-summary-label">
                    Creado por
                </span>

                <div class="order-summary-value">
                    @if (!string.IsNullOrWhiteSpace(Model.CreatedByEmail))
                    {
                        @Model.CreatedByEmail
                    }
                    else
                    {
                        <span class="text-muted">
                            No disponible
                        </span>
                    }
                </div>
            </div>
        }

        <div>
            <span class="order-summary-label">
                Estado
            </span>

            <div class="order-summary-value">
                @switch (Model.Status)
                {
                    case OrderStatus.Pending:
                        <span class="badge bg-warning text-dark">
                            Pendiente
                        </span>
                        break;

                    case OrderStatus.Preparing:
                        <span class="badge bg-primary">
                            Preparando
                        </span>
                        break;

                    case OrderStatus.Ready:
                        <span class="badge bg-info text-dark">
                            Listo
                        </span>
                        break;

                    case OrderStatus.Delivered:
                        <span class="badge bg-success">
                            Entregado
                        </span>
                        break;

                    case OrderStatus.Cancelled:
                        <span class="badge bg-danger">
                            Cancelado
                        </span>
                        break;
                }
            </div>
        </div>

    </div>

</div>

<div class="orders-table-card mb-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0 orders-table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio unitario</th>
            <th>Subtotal</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var detail in Model.OrderDetails)
        {
            <tr>
                <td>@detail.Product.Name</td>

                <td>@detail.Quantity</td>

                <td>
                    @detail.UnitPrice.ToString("C")
                </td>

                <td>
                    @detail.Subtotal.ToString("C")
                </td>
            </tr>
        }
    </tbody>
        </table>
    </div>
</div>

<div class="order-total-summary">
    <span class="order-total-label">
        Total del pedido
    </span>

    <span class="order-total-value">
        @Model.Total.ToString("C")
    </span>
</div>

<a asp-action="Index"
   class="btn order-back-btn">
    ← Volver a pedidos
</a>
@if (User.IsInRole("Administrador"))
{
    <div class="card shadow-sm border-0 mt-4">

        <div class="card-body">

            <h4 class="fw-bold mb-3">
                Historial del pedido
            </h4>

            @if (Model.StatusHistory != null &&
                 Model.StatusHistory.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Cambio de estado</th>
                                <th>Usuario</th>
                                <th>Fecha y hora</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var history in
                                Model.StatusHistory
                                    .OrderByDescending(h => h.ChangedAt))
                            {
                                <tr>

                                    <td>
                                        <span class="badge @GetStatusBadgeClass(history.PreviousStatus)">
                                            @GetStatusName(history.PreviousStatus)
                                        </span>

                                        <span class="text-muted mx-2">
                                            →
                                        </span>

                                        <span class="badge @GetStatusBadgeClass(history.NewStatus)">
                                            @GetStatusName(history.NewStatus)
                                        </span>
                                    </td>

                                    <td>
                                        @history.ChangedByEmail
                                    </td>

                                    <td>
                                       @(BusinessTimeService.ToLocalTime(history.ChangedAt)
    .ToString("dd/MM/yyyy hh:mm tt"))
                                        
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-light border mb-0">
                    Este pedido todavía no tiene cambios
                    registrados en el historial.
                </div>
            }

        </div>

    </div>
}
@model FoodDispatchSystem.Web.ViewModels.BusinessEditViewModel

@{
    ViewData["Title"] = "Configuración del negocio";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                Configuración del negocio
            </h1>

            <p class="text-muted mb-0">
                Administra la información general de tu negocio.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Volver al Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="row">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h4 class="fw-semibold mb-1">
                        Información general
                    </h4>

                    <p class="text-muted mb-4">
                        Estos datos se utilizan para personalizar FoodDispatch.
                    </p>

                    <form asp-controller="Business"
                          asp-action="Index"
                          method="post"
                          enctype="multipart/form-data">

                        <input asp-for="Id"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Address"
                                   class="form-control" />

                            <span asp-validation-for="Address"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Phone"
                                       class="form-control" />

                                <span asp-validation-for="Phone"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Email"
                                       class="form-control" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>

                        <div class="mb-4">
                            <label asp-for="CurrencyCode"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="CurrencyCode"
                                    class="form-select">

                                <option value="USD">
                                    USD - Dólar estadounidense
                                </option>

                            </select>

                            <span asp-validation-for="CurrencyCode"
                                  class="text-danger">
                            </span>
                        </div>
                        <div class="mb-4">

                            <label asp-for="LogoFile"
                                   class="form-label fw-semibold">
                            </label>

                            @if (!string.IsNullOrWhiteSpace(Model.CurrentLogoPath))
                            {
                                <div class="mb-3">
                                    <p class="text-muted small mb-2">
                                        Logo actual
                                    </p>

                                    <img src="@Model.CurrentLogoPath"
                                         alt="Logo del negocio"
                                         class="img-thumbnail"
                                         style="max-height: 120px; max-width: 220px;" />
                                </div>
                            }

                            <input asp-for="LogoFile"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                            <div class="form-text">
                                Formatos permitidos: JPG, PNG o WEBP. Máximo 2 MB.
                            </div>

                            <span asp-validation-for="LogoFile"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Guardar cambios
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>

        <div class="col-lg-4 mt-4 mt-lg-0">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h5 class="fw-semibold">
                        Personalización
                    </h5>

                    <p class="text-muted small">
                        El nombre configurado aquí se mostrará automáticamente
                        en el menú, Dashboard y pantalla de inicio de sesión.
                    </p>

                    <hr />

                    <p class="small text-muted mb-1">
                        Próximamente
                    </p>

                    <ul class="small mb-0">
                        <li>Logo del negocio</li>
                        <li>Información comercial</li>
                        <li>Preferencias visuales</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
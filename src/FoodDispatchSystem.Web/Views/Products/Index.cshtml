@model IEnumerable<FoodDispatchSystem.Web.Models.Product>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    Aquí se mostrarán los productos disponibles del menú.
</p>

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Nuevo producto
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Description</td>

                <td>
                    @product.Category.Name
                </td>

                <td>
                    $@product.Price.ToString("0.00")
                </td>

                <td>
                    @if (product.IsActive)
                    {
                        <span>Activo</span>
                    }
                    else
                    {
                        <span>Inactivo</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@product.Id"
                       class="btn btn-sm btn-warning">
                        Editar
                    </a>

                    @if (product.IsActive)
                    {
                        <a asp-action="Delete"
                           asp-route-id="@product.Id"
                           class="btn btn-sm btn-danger">
                            Desactivar
                        </a>
                    }
                    else
                    {
                        <form asp-action="Reactivate"
                              asp-route-id="@product.Id"
                              method="post"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-sm btn-success">
                                Reactivar
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

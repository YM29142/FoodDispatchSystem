@model IEnumerable<FoodDispatchSystem.Web.Models.Product>

@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

    <div>
        <h1 class="mb-1">
            Productos
        </h1>

        <p class="text-muted mb-0">
            Administra los productos disponibles del menú.
        </p>
    </div>

    <a asp-action="Create"
       class="btn quick-action-btn quick-action-primary">
        + Nuevo producto
    </a>

</div>

<div class="orders-table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0 orders-table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Description</td>

                <td>
                    @product.Category.Name
                </td>

                <td>
                    $@product.Price.ToString("0.00")
                </td>

               <td>
    @if (product.IsActive)
    {
        <span class="badge bg-success">
            Activo
        </span>
    }
    else
    {
        <span class="badge bg-secondary">
            Inactivo
        </span>
    }
</td>
               <td>
    <a asp-action="Edit"
       asp-route-id="@product.Id"
       class="btn btn-sm product-action-btn product-edit-btn">
        Editar
    </a>

    @if (product.IsActive)
    {
        <a asp-action="Delete"
           asp-route-id="@product.Id"
           class="btn btn-sm product-action-btn product-disable-btn">
            Desactivar
        </a>
    }
    else
    {
        <form asp-action="Reactivate"
              asp-route-id="@product.Id"
              method="post"
              class="d-inline">

            <button type="submit"
                    class="btn btn-sm product-action-btn product-reactivate-btn">
                Reactivar
            </button>
        </form>
    }
</td>
            </tr>
        }
    </tbody>
        </table>
    </div>
</div>

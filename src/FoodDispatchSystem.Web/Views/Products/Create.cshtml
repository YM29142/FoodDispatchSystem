@model FoodDispatchSystem.Web.Models.Product

@{
    ViewData["Title"] = "Nuevo producto";
}

<div class="mb-4">
    <h1 class="mb-1">
        Nuevo producto
    </h1>

    <p class="text-muted mb-0">
        Registra un nuevo producto para incluirlo en el menú.
    </p>
</div>

<div class="row">
    <div class="col-lg-7 col-md-9 product-form-card">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="mb-3">
                <label asp-for="Name"
                       class="form-label">
                    Nombre
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Description"
                       class="form-label">
                    Descripción
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="3">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Price"
                       class="form-label">
                    Precio
                </label>

                <input asp-for="Price"
                       class="form-control"
                       type="number"
                       step="0.01"
                       min="0.01" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId"
                       class="form-label">
                    Categoría
                </label>

                <select asp-for="CategoryId"
                        asp-items="ViewBag.CategoryId"
                        class="form-select">

                    <option value="">
                        -- Seleccione una categoría --
                    </option>

                </select>

                <span asp-validation-for="CategoryId"
                      class="text-danger">
                </span>
            </div>
<div class="form-check form-switch product-active-switch mb-4">

    <input asp-for="IsActive"
           class="form-check-input" />

    <label asp-for="IsActive"
           class="form-check-label">
        Producto activo
    </label>

    <div class="form-text">
        Los productos activos estarán disponibles al crear pedidos.
    </div>

</div>

           <button type="submit"
        class="btn order-create-btn">
    Guardar
</button>

            <a asp-action="Index"
   class="btn order-cancel-btn">
    Cancelar
</a>

        </form>

    </div>
</div>